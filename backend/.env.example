# DEIS backend environment template.
# Copy to .env and fill in real values. NEVER commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection (local by default, Supabase-managed in production)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/deis?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Optional: GROQ LLM API key for the AI enrollment assistant.
# Get one at https://console.groq.com/keys (free tier available).
# Without it, the assistant falls back to an offline rule-based responder.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Google OAuth "Sign in with Google".
# Create an OAuth client ID at https://console.cloud.google.com -> Credentials.
# Authorized JS origins: http://localhost:5173 (+ production frontend origin).
# Authorized redirect URIs: http://localhost:4000/api/auth/google/callback
#   (+ https://<frontend-origin>/api/auth/google/callback).
# If GOOGLE_REDIRECT_URI is omitted the server derives it from the request host.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Maintenance mode: set to true (or 1) to block all API routes except /api/health
# and make the frontend show the maintenance page. Default false.
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=The system is currently under maintenance. Please check back shortly.
