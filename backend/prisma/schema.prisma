// DEIS - DOrSU Enrollment Information System
// Prisma schema. Development uses local PostgreSQL 17; production uses Supabase (PostgreSQL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  FACULTY
  REGISTRAR
  ADMIN
  ACCOUNTING
  ADMISSION
  OSA
  OHS
  CASHIERING
  OSCD
  FAASG
}

enum Sex {
  MALE
  FEMALE
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum GradeStatus {
  DRAFT
  FINALIZED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String
  fullName           String
  role               Role     @default(STUDENT)
  mustChangePassword Boolean  @default(false)
  isActive           Boolean  @default(true)
  tokenVersion       Int      @default(0)
  dpaConsentAt       DateTime?
  dpaConsentVersion  Int      @default(0)
  totpSecret         String?
  totpEnabledAt      DateTime?
  totpRecoveryCodes  String?
  passwordQuestions  String?
  resetNonce         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  student           StudentProfile?
  facultySections   Section[]           @relation("FacultySections")
  reviewedRequests  EnrollmentRequest[] @relation("ReviewedRequests")
  gradeRecords      GradeRecord[]       @relation("GradedRecords")
  clearanceReviews  ClearanceSignoff[]  @relation("ClearanceReviewer")
  activities        ActivityRecord[]
  passwordHistory   UserPasswordHistory[]
  universityActivities UniversityActivity[]

  @@index([role])
}

model UserPasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model StudentProfile {
  id             String   @id @default(uuid())
  userId         String?  @unique // null until the student activates credentials
  studentNo      String   @unique
  firstName      String
  lastName       String
  yearLevel      Int      @default(1)
  sex            Sex
  strand         String?
  programId      String
  campusId       String
  activationCode String   @unique
  enrolledAt     DateTime @default(now())

  // I. Application for Admission (Student Profile Form FM-DOrSU-ODI-05)
  applicantType     String? // FIRST_YEAR | TRANSFEREE | RETURNEE
  lrn               String?
  preferredCourse1  String?
  preferredCourse2  String?
  preferredCourse3  String?
  admissionTerm     String? // e.g. "1st Semester, AY 2025-2026"

  // II. Personal Information
  middleName           String?
  dateOfBirth          DateTime?
  placeOfBirthCity     String?
  placeOfBirthProvince String?
  placeOfBirthCountry  String?
  civilStatus          String? // SINGLE | MARRIED | WIDOWED | SEPARATED
  citizenship          String?
  heightFt             String?
  weightKg             String?
  religion             String?
  tribe                String?
  personalEmail        String?
  contactNumber        String?
  permanentAddress     String?
  zipCode              String?
  photo                String? // base64 2x2 ID photo, <= 1MB

  // III. Family Background
  spouseName          String?
  spouseOccupation    String?
  numberOfChildren    Int?
  fatherName          String?
  fatherOccupation    String?
  fatherContact       String?
  motherName          String?
  motherOccupation    String?
  motherContact       String?
  parentsStatus       String? // LIVING_TOGETHER | PERMANENTLY_SEPARATED | ANNULLED | TEMPORARILY_SEPARATED | FATHER_OTHER_PARTNER | MOTHER_OTHER_PARTNER
  monthlyFamilyIncome String?
  emergencyName       String?
  emergencyContact    String?
  emergencyAddress    String?

  // IV. SCAS Result (index per aptitude)
  scasGeneral        Decimal? @db.Decimal(5, 2)
  scasSpatial        Decimal? @db.Decimal(5, 2)
  scasVerbal         Decimal? @db.Decimal(5, 2)
  scasPerceptual     Decimal? @db.Decimal(5, 2)
  scasNumerical      Decimal? @db.Decimal(5, 2)
  scasManualDexterity Decimal? @db.Decimal(5, 2)

  // V. Unique Features
  hobbies        String?
  motto          String?
  specialSkills  String?
  specialInterests String?

  // VI. Educational Background
  elementarySchool     String?
  elementaryYear       String?
  shsSchool            String?
  shsStrand            String?
  shsYear              String?
  vocationalCourse     String?
  vocationalYear       String?
  collegeDegree        String?
  collegeYear          String?

  spfCompletedAt DateTime?

  user    User?   @relation(fields: [userId], references: [id])
  program Program @relation(fields: [programId], references: [id])
  campus  Campus  @relation(fields: [campusId], references: [id])

  enrollmentRequests EnrollmentRequest[]
  grades             GradeRecord[]
  clearances         StudentClearance[]
}

model Campus {
  id       String @id @default(uuid())
  code     String @unique
  name     String
  isMain   Boolean @default(false)
  students StudentProfile[]
  faculties Faculty[]
  programs Program[]

  @@index([code])
}

model Faculty {
  id       String @id @default(uuid())
  code     String @unique
  name     String
  campusId String
  campus   Campus  @relation(fields: [campusId], references: [id])
  programs Program[]
}

model Program {
  id         String @id @default(uuid())
  code       String @unique
  name       String
  level      String @default("Undergraduate")
  campusId   String
  facultyId  String
  totalUnits Int    @default(0)

  campus   Campus   @relation(fields: [campusId], references: [id])
  faculty  Faculty  @relation(fields: [facultyId], references: [id])
  subjects Subject[]
  students StudentProfile[]
}

model Subject {
  id           String @id @default(uuid())
  code         String @unique
  title        String
  units        Int
  lectureHours Int    @default(0)
  labHours     Int    @default(0)
  yearLevel    Int    @default(1)
  semester     Int    @default(1)

  programId String
  program   Program   @relation(fields: [programId], references: [id])
  requires  SubjectRule[] @relation("SubjectRuleTarget")
  requiredBy SubjectRule[] @relation("SubjectRuleSource")

  sections Section[]

  @@index([programId, yearLevel, semester])
}

model SubjectRule {
  id        String @id @default(uuid())
  subjectId String
  prereqId  String

  subject Subject @relation("SubjectRuleTarget", fields: [subjectId], references: [id])
  prereq  Subject @relation("SubjectRuleSource", fields: [prereqId], references: [id])

  @@unique([subjectId, prereqId])
}

model Term {
  id             String   @id @default(uuid())
  code           String   @unique
  label          String
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean  @default(false)
  enrollmentOpen Boolean  @default(false)

  sections Section[]
  requests EnrollmentRequest[]
  clearances StudentClearance[]

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Enrollment
// ---------------------------------------------------------------------------

model EnrollmentRequest {
  id           String           @id @default(uuid())
  studentId    String
  termId       String
  status       EnrollmentStatus @default(PENDING)
  reviewNotes  String?
  reviewedById String?
  submittedAt  DateTime         @default(now())
  reviewedAt   DateTime?
  studentNote  String?
  paymentRef   String?
  paymentAmount Decimal?        @db.Decimal(9, 2)
  paymentPaidAt DateTime?

  student    StudentProfile @relation(fields: [studentId], references: [id])
  term       Term           @relation(fields: [termId], references: [id])
  reviewedBy User?          @relation("ReviewedRequests", fields: [reviewedById], references: [id])
  items      EnrollmentItem[]

  @@unique([studentId, termId])
  @@index([status])
}

model EnrollmentItem {
  id        String @id @default(uuid())
  requestId String
  sectionId String

  request EnrollmentRequest @relation(fields: [requestId], references: [id])
  section Section           @relation(fields: [sectionId], references: [id])

  @@unique([requestId, sectionId])
  @@index([sectionId])
}

model Section {
  id        String @id @default(uuid())
  code      String @unique
  subjectId String
  termId    String
  facultyId String
  schedule  String
  room      String
  capacity  Int    @default(40)

  subject Subject @relation(fields: [subjectId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])
  faculty User    @relation("FacultySections", fields: [facultyId], references: [id])

  items  EnrollmentItem[]
  grades GradeRecord[]

  @@index([termId, subjectId])
}

model GradeRecord {
  id         String     @id @default(uuid())
  sectionId  String
  studentId  String
  prelim     Decimal?   @db.Decimal(5, 2)
  midterm    Decimal?   @db.Decimal(5, 2)
  final      Decimal?   @db.Decimal(5, 2)
  grade      Decimal?   @db.Decimal(5, 2)
  status     GradeStatus @default(DRAFT)
  gradedById String?
  gradedAt   DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  section  Section        @relation(fields: [sectionId], references: [id])
  student  StudentProfile @relation(fields: [studentId], references: [id])
  gradedBy User?          @relation("GradedRecords", fields: [gradedById], references: [id])

  @@unique([sectionId, studentId])
}

model ActivityRecord {
  id         String   @id @default(uuid())
  actorId    String?
  actionKey  String
  entityType String
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
}

// ---------------------------------------------------------------------------
// University calendar
// ---------------------------------------------------------------------------

model UniversityActivity {
  id          String   @id @default(uuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  type        String   @default("ACADEMIC") // ACADEMIC | ADMINISTRATIVE | CULTURAL | SPORTS | OTHER
  audience    String   @default("ALL") // ALL | STUDENTS | FACULTY | ADMIN
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([startsAt])
}

// ---------------------------------------------------------------------------
// Enrollment policy (evaluator-configurable rules)
// ---------------------------------------------------------------------------

model EnrollmentPolicy {
  key   String @id
  value String
}

// ---------------------------------------------------------------------------
// Clearance
// ---------------------------------------------------------------------------

model ClearanceTemplate {
  id        String  @id @default(uuid())
  code      String  @unique
  label     String
  category  String  // e.g. LIBRARY | FINANCE | DEPARTMENT | GUIDANCE | REGISTRAR
  ownerRole String? // staff role that owns this office's signoff, e.g. OSA | OHS; null = shared

  signoffs ClearanceSignoff[]

  @@index([category])
  @@index([ownerRole])
}

model StudentClearance {
  id        String   @id @default(uuid())
  studentId String
  termId    String
  status    String   @default("IN_PROGRESS") // IN_PROGRESS | CLEARED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  StudentProfile      @relation(fields: [studentId], references: [id])
  term     Term                @relation(fields: [termId], references: [id])
  signoffs ClearanceSignoff[]

  @@unique([studentId, termId])
  @@index([termId, status])
}

model ClearanceSignoff {
  id                  String   @id @default(uuid())
  clearanceId         String
  templateId          String
  status              String   @default("PENDING") // PENDING | CLEARED
  note                String?
  reviewedById        String?
  reviewedAt          DateTime?

  clearance StudentClearance @relation(fields: [clearanceId], references: [id])
  template  ClearanceTemplate @relation(fields: [templateId], references: [id])
  reviewedBy User?            @relation("ClearanceReviewer", fields: [reviewedById], references: [id])

  @@unique([clearanceId, templateId])
  @@index([templateId, status])
}