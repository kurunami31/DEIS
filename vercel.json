{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build && npm --prefix backend exec prisma generate -- --schema backend/prisma/schema.prisma",
  "installCommand": "npm install",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.mjs": {
      "regions": ["nrt1"],
      "includeFiles": "backend/node_modules/.prisma/**"
    }
  }
}
